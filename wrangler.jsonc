{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starseed2",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-05",
  "workers_dev": true,
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "starseed2-calibration", "database_id": "5eecb7fe-e338-44e1-b9d0-4262fea36f4d", "migrations_dir": "migrations"}],
  "ratelimits": [{"name": "RATE_LIMITER", "namespace_id": "1001", "simple": {"limit": 60, "period": 60}}],
  "vars": {"BUILD_VERSION": "1.0.0-layout-20260905-2"},
  "observability": {"enabled": false}
}
